{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "base",
  "type": "registry:style",
  "description": "Reset @layer base partagé grappe : bordures par défaut, cursor pointer sur interactifs, cursor not-allowed sur disabled. Reprise des conventions déjà alignées Wepo + ResSalles.",
  "css": {
    "@layer base": {
      "*, *::before, *::after": {
        "border-color": "var(--color-border)"
      },
      "button:not(:disabled), [role=\"button\"]:not([aria-disabled=\"true\"]), a[href], label[for], summary, select:not(:disabled), input[type=\"checkbox\"]:not(:disabled), input[type=\"radio\"]:not(:disabled), input[type=\"submit\"]:not(:disabled), input[type=\"button\"]:not(:disabled), input[type=\"reset\"]:not(:disabled)": {
        "cursor": "pointer !important"
      },
      "button:disabled, [role=\"button\"][aria-disabled=\"true\"], select:disabled, input:disabled": {
        "cursor": "not-allowed !important"
      }
    }
  }
}
